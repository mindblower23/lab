[gd_resource type="Shader" format=3 uid="uid://cuj7pdc5c35yq"]

[resource]
code = "shader_type spatial;
uniform sampler2D albedo_texture : source_color;
uniform sampler2D wind_mask;
uniform float speed = 1.0;
uniform float strength = 8.0;

void vertex() {
	// Called for every vertex the material is visible on.
	float mask = textureLod(wind_mask, UV, 0.0).r;
	float wave = sin(TIME * speed * NODE_POSITION_WORLD.x);
	VERTEX.x += wave * strength * mask;
	//float world_x = NODE_POSITION_WORLD.x;
	//float body_sway = sin(TIME * speed * world_x);
	//VERTEX.x += body_sway;
}

void fragment() {
	// Called for every pixel the material is visible on.
	vec4 tex = texture(albedo_texture, UV);
	ALBEDO = tex.rgb;
	ALPHA = tex.a;
	ALPHA_SCISSOR_THRESHOLD = 0.5;
}

//void light() {
//	// Called for every pixel for every light affecting the CanvasItem.
//	// Uncomment to replace the default light processing function with this one.
//}
"
